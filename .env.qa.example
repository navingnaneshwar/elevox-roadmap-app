# .env.qa
# ─────────────────────────────────────────────────────────────
# Local QA environment — copy to .env.qa and fill in values.
# Run with: npm run dev:qa
# NEVER commit .env.qa to git.
# ─────────────────────────────────────────────────────────────

# Supabase — elevox-qa project
# Get from: Supabase Dashboard → elevox-qa → Settings → API
VITE_SUPABASE_URL=https://your-qa-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...your-qa-anon-key...

# Environment label (used in UI env indicator)
VITE_ENV=qa

# Stripe — test key (same for QA and Dev, production uses live key)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
