# .env.example
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────

# ── Supabase (Frontend — safe for browser) ─────────────────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-from-supabase-dashboard

# ── Stripe (Frontend — publishable key only) ───────────────
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ─────────────────────────────────────────────────────────────
# The keys below go into Supabase Edge Function secrets.
# Set them via: supabase secrets set KEY=value
# OR via Supabase Dashboard → Settings → Edge Functions
# ─────────────────────────────────────────────────────────────

# ── Anthropic ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Stripe (Server-side — secret key, NEVER in browser) ───
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_AUTHORITY=price_...
STRIPE_PRICE_LEGACY=price_...

# ── Supabase (Edge Functions — service role key) ───────────
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-from-supabase-dashboard

# ── Email (Resend) ─────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@elevox.com

# ── LinkedIn OAuth (for social posting — Sprint 3) ────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ── Meta Graph API (Instagram + Facebook — Sprint 3) ──────
META_APP_ID=
META_APP_SECRET=

# ── X / Twitter API (Sprint 3) ────────────────────────────
TWITTER_API_KEY=
TWITTER_API_SECRET=

# ── Slack (for approval notifications — Sprint 3) ─────────
SLACK_BOT_TOKEN=xoxb-...

# ── WhatsApp Business API (Sprint 3) ──────────────────────
WHATSAPP_API_TOKEN=
