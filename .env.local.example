# .env.local
# ─────────────────────────────────────────────────────────────
# Local development environment — copy to .env.local.
# Run with: npm run dev
# NEVER commit .env.local to git.
#
# For local dev we point at the QA Supabase project so there
# is no risk of polluting production data.
# ─────────────────────────────────────────────────────────────

# Supabase — point at elevox-qa (safe for local dev)
VITE_SUPABASE_URL=https://your-qa-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...your-qa-anon-key...

# Environment label
VITE_ENV=development

# Stripe — test key
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
